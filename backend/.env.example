PORT=4100

# Same Postgres database as the other backend (backend/.env) — this service
# only ever touches its own gv_-prefixed tables (gv_buildings, gv_floors,
# gv_viewpoints, gv_captured_images, gv_gvi_results, gv_vegetation_masks,
# gv_processing_jobs), so it's safe to point at the same connection string.
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Comma-separated list of allowed production origins, or * to allow any.
# Vercel preview deployments (https://*.vercel.app) are always allowed
# regardless of this value, since their URL changes per deploy.
CORS_ORIGIN=*

# Simple shared-secret admin auth (this service has no login/session system
# of its own) — every mutating request must send `Authorization: Bearer
# <ADMIN_TOKEN>`. Set the same value in cesium-demo/.env as
# VITE_BALCONY_ADMIN_TOKEN.
ADMIN_TOKEN=change-me

# Must point at a running cesium-demo dev server (its ?automation=1 capture
# harness) reachable from this backend process.
BALCONY_FRONTEND_URL=http://localhost:5173

# Image storage (previews/masks). If SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# are set, images upload to Supabase Storage (durable — survives redeploys).
# Otherwise falls back to the local filesystem below, which is dev-only:
# Render's web service disk is ephemeral and gets wiped on every deploy.
# Service-role key (not anon key) — Project Settings > API in Supabase —
# never expose this to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Bucket must exist already; create it once in Supabase Storage.
SUPABASE_STORAGE_BUCKET=balcony-images

# Local filesystem image storage root — only used when Supabase env vars
# above are absent (see src/services/storage.ts).
BALCONY_STORAGE_DIR=./storage

# Per-viewpoint capture timeout before a job is retried/failed.
BALCONY_CAPTURE_TIMEOUT_MS=60000
