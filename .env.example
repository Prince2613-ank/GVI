# Optional: your own free Cesium ion token (https://ion.cesium.com/tokens).
# Without this, the app uses Cesium's shared demo token, which works fine
# for this POC but shows a "default access token" watermark and is rate-limited.
VITE_CESIUM_ION_TOKEN=
VITE_LIDAR_API_URL=http://localhost:8001
# Optional Cesium quantized-mesh terrain endpoint generated from the DTM.
VITE_TERRAIN_URL=
# Render resolution multiplier (0 < n <= 1). Unset/1 renders at full device
# resolution. 0.85 cuts GPU fill-rate work by roughly 28% for a slight
# softening — a good default on laptops and integrated graphics. Drop to
# 0.75 on very constrained machines, or set 1 for screenshot-quality output.
VITE_CESIUM_RESOLUTION_SCALE=0.85
# Optional point-cloud/mesh tileset produced by backend/lidar/export_tiles.py.
VITE_LIDAR_3D_TILES_URL=
# Enable the Balcony Viewpoint Debug developer tool (src/features/balcony-debug).
VITE_ENABLE_BALCONY_DEBUG=false

# Standalone Green View backend (see cesium-demo/backend/) — automated
# balcony viewpoint generation. Run it separately: `cd backend && npm run dev`
# (inside cesium-demo/backend), defaults to port 4100.
VITE_BALCONY_API_URL=http://localhost:4100/api/balcony-viewpoints
# Must match ADMIN_TOKEN in cesium-demo/backend/.env — required for
# Generate/Pause/Resume/Cancel/Retry/Regenerate. Leave blank to use the
# control panel read-only.
VITE_BALCONY_ADMIN_TOKEN=
